# Kashio configuration. Copy to `.env` for local runs; on Railway, add these under Variables.
# Never commit `.env` (it is in .gitignore). Lines starting with # are comments.

# --- Telegram ---------------------------------------------------------------
# Token from @BotFather (/newbot). Also run /setprivacy → Disable so the bot sees group messages.
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token
# Pairing. Easiest: leave both empty, deploy, add the bot to your group and type /setup there (as a group
# admin). The bot stores the group id and your id in a hidden Bot_Config tab of the spreadsheet; no redeploy.
# Setting them here instead overrides what /setup stored.
# The GROUP to record, as a chat id (a negative number such as -1001234567890): the group itself, not a person.
TELEGRAM_CHAT_ID=
# Where full sync reports go: your private chat with the bot, whose id is simply your own Telegram user id.
# Press Start in that chat once, or Telegram will not let the bot message you.
TELEGRAM_ADMIN_CHAT_ID=

# --- Anthropic --------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-replace-with-your-key
ANTHROPIC_MODEL=claude-sonnet-5
# Thinking effort: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high
# Prices used only to estimate the cost written to the run log (USD per million tokens).
ANTHROPIC_PRICE_INPUT_PER_MILLION=2.0
ANTHROPIC_PRICE_OUTPUT_PER_MILLION=10.0

# --- Google Sheets ----------------------------------------------------------
# The service-account key, one of two ways. Share the spreadsheet with its client_email as Editor.
#  (a) the whole key file as ONE line. In a .env file wrap it in single quotes; in Railway paste it as is.
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"...@....iam.gserviceaccount.com"}'
#  (b) or, for local runs, a path to the downloaded file (key files are git-ignored).
# GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
# Optional. From the spreadsheet URL: https://docs.google.com/spreadsheets/d/<THIS PART>/edit
# Leave empty and the bot finds the spreadsheet shared with the service account by itself (needs the Google
# Drive API enabled in the same Cloud project; if several are shared, the one that has SHEET_TAB wins).
GOOGLE_SHEET_ID=
# Tab that receives the transactions (columns B date, C amount, D currency, E description, G category).
# Created with a header row if it does not exist yet.
SHEET_TAB=Transactions_Trip#2
# Hidden tabs the bot creates and manages: raw messages, run log, pairing configuration.
INBOX_TAB=Bot_Inbox
RUNS_TAB=Bot_Runs
CONFIG_TAB=Bot_Config

# --- Behaviour --------------------------------------------------------------
# When the scheduled sync runs, in crontab syntax, evaluated in TIMEZONE.
# Default: 09:00 on the 1st and 15th. Weekly on Mondays would be: 0 9 * * 1
SYNC_CRON=0 9 1,15 * *
TIMEZONE=Europe/Istanbul
# A scheduled sync only calls Claude when at least this many messages are pending.
SCHEDULED_MIN_MESSAGES=5
# /sync calls Claude when at least this many messages are pending; otherwise it replies "nothing new".
MANUAL_MIN_MESSAGES=1
# Messages sent before this hour count for the previous day (a note at 01:28 is about yesterday).
DAY_ROLLOVER_HOUR=4
# Used when a message names no currency. One of: TRY, TOMAN, EUR, USD, GBP
DEFAULT_CURRENCY=TRY
# Post a one-line summary in the group after each sync.
POST_SUMMARY=true
